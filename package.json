{
    "name": "auth-service",
    "version": "1.0.0",
    "description": "The user management service for the pizzeria application.",
    "homepage": "https://github.com/sukrutd/pizzeria-auth-service#readme",
    "bugs": {
        "url": "https://github.com/sukrutd/pizzeria-auth-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sukrutd/pizzeria-auth-service.git"
    },
    "license": "ISC",
    "author": "Sukrut Daphalapurkar",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "type-check": "tsc --watch",
        "format:check": "prettier . --check",
        "format:fix": "prettier . --write",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/node": "^24.13.3",
        "eslint": "^10.8.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.2.0",
        "prettier": "3.9.6",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "http-errors": "^2.0.1",
        "winston": "^3.19.0"
    },
    "lint-staged": {
        "*.ts": [
            "npm run lint:fix",
            "npm run format:fix"
        ]
    }
}
